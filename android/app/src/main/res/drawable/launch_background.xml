<?xml version="1.0" encoding="utf-8"?>
<!-- Splash (Android 11 and below): the RES-Q app tile centred on the window background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    <item android:gravity="center" android:width="112dp" android:height="112dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient android:angle="315" android:startColor="#1A73E8" android:endColor="#174EA6" />
        </shape>
    </item>
    <item android:gravity="center" android:width="112dp" android:height="112dp" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
